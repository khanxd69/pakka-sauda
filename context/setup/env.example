# Pakka Sauda: copy to .env.local (never commit .env.local). Also set the same values in Vercel → Project → Settings → Environment Variables.
# Share the secret values over a private channel, never in git or in an AI chat.

# --- Supabase (Workstream A creates the project; Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET: server only. Never prefix with NEXT_PUBLIC_.

# --- Uplift AI (Workstream C; platform.upliftai.org/studio/api-keys) ---
UPLIFT_API_KEY=                       # SECRET
UPLIFT_VOICE_ID=v_8eelc901            # pick a voice at docs.upliftai.org/orator_voices
STT_PROVIDER=browser                  # 'uplift' or 'browser': set after the phone test (C0.2)
NEXT_PUBLIC_STT_PROVIDER=browser      # must match STT_PROVIDER
NEXT_PUBLIC_TTS_DISABLED=             # set to 1 locally to use the browser voice and save Uplift minutes

# --- LLM fallback for reading numbers (optional) ---
ANTHROPIC_API_KEY=                    # SECRET; if empty, only the deterministic parser is used
LLM_MODEL=claude-haiku-5-5

# --- Business constants (defaults shown) ---
PLATFORM_FEE_PERCENT=1
TOKEN_PERCENT=10
TOKEN_WINDOW_MINUTES=30
